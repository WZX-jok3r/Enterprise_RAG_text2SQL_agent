# ==================== SiliconFlow API 配置 ====================
# 【需要你提供】唯一必填项：SiliconFlow 控制台获取的 API Key
# 获取地址: https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=

# API 地址（国内默认即可，无需修改）
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ==================== Qdrant 向量库配置 ====================
# 与 docker_setting/docker-compose.yml 中的端口映射一致，无需修改
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=personal_rag_v2

# ==================== Embedding 模型配置 ====================
# bge-m3 向量维度为 1024，若更换模型需同步修改 VECTOR_DIM
EMBEDDING_MODEL=BAAI/bge-m3
VECTOR_DIM=1024

# ==================== LLM 配置 ====================
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# ==================== Chunk 分块配置 ====================
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=50

# ==================== 检索配置 ====================
TOP_K=5

# ==================== Rerank 精排配置 ====================
# 使用 SiliconFlow /v1/rerank（复用上方 API Key），模型 BAAI/bge-reranker-v2-m3
# 关闭精排：RERANK_ENABLED=false
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATES=20

RAG_TENANT_KEYS=a=abc_wzx11;b=bca_wzx11;c=cab_wzx11

# ==================== Analytics 只读库（Text2SQL）====================
# 业务数据放独立库，由独立只读角色访问，与系统元数据库 rag 物理隔离。
# 只读角色只有 SELECT 权限（见 backend/app/analytics/sql/001_init.sql），
# LLM 生成的 SQL 永远碰不到 messages（会话内容）/ tenants（租户表）。
#
# 建库与建角色（幂等，可反复执行）：
#   cd backend && python -m app.analytics.setup_db
ANALYTICS_DB=kb_analytics
ANALYTICS_RO_USER=kb_ro

# 只读角色口令。
# ⚠️ 留空 = 使用代码里的本地开发默认值（仅适合本机演示；角色只有 SELECT，
#    爆炸半径限于业务数据）。生产环境必须显式注入强口令。
#
# 为什么本地也必须用口令（实测结论）：Docker 端口发布走 NAT，宿主机的 127.0.0.1
# 在容器侧被改写为网桥网关地址，因此 pg_hba.conf 里
#   host all all 127.0.0.1/32 trust
# 这条规则**对宿主机连接永不生效**，实际匹配末行的 scram-sha-256，必须提供口令。
ANALYTICS_RO_PASSWORD=
ANALYTICS_EMPLOYEE_USER=kb_employee
# 开发环境留空使用本地默认；production/staging 必须设置独立强口令。
ANALYTICS_EMPLOYEE_PASSWORD=

# ---- Text2SQL 执行护栏 ----
# 单次查询返回行数硬上限（超限截断并标注 truncated=true）
SQL_MAX_ROWS=200
# 单条 SQL 语句超时（毫秒），设在连接上保证 PG 侧真的停下
SQL_TIMEOUT_MS=5000
# 结果超过该行数时不再把明细塞进 prompt，改为只给统计概要
# （LLM 无法预知结果集大小，上千行明细会炸掉上下文窗口）
SQL_INLINE_MAX_ROWS=50
# 生成 SQL 失败后允许带错误信息重写的最多次数
SQL_MAX_RETRY=2

# ==================== RBAC 与 SQL 审计（P7）====================
# 为什么接入 Text2SQL 后必须补 RBAC：
#   纯 RAG 时代"能看到什么"取决于文档里写了什么；接入 SQL 之后，
#   "能查到什么"变成可枚举的数据权限问题（例如"全公司薪资最高的人是谁"），
#   这把租户隔离从技术问题升级为**合规问题**。
#
# 可选角色：
#   analyst  —— 数据分析角色，可见全部列（默认角色，等价于未启用 RBAC 的行为）
#   employee —— 普通员工，SQL 仅允许查询授权列；敏感列与派生查询被拒绝
#
# 向后兼容：不配置 RAG_TENANT_ROLES 时所有人都用 DEFAULT_ROLE(=analyst)，
# 且脱敏只对非特权角色生效 ⇒ 不配置就等于没有这个功能，既有部署零影响。
DEFAULT_ROLE=analyst
# production/staging 必须改为 employee；分析员通过 RAG_TENANT_ROLES 显式授权。

# 按租户指定角色：格式 tenant_id=role;tenant2=role2
# 例：把租户 b 降为 employee，其查询结果中的敏感列会被脱敏
# RAG_TENANT_ROLES=b=employee;c=employee
RAG_TENANT_ROLES=

# 敏感列清单（逗号分隔的 "表.列"）。SQL 预检与数据库列授权使用同一配置。
# 修改后重新运行 python -m app.analytics.setup_db 更新数据库列权限。
SQL_REDACT_COLUMNS=employees.salary,employees.email

# SQL 审计开关：把每次 LLM 生成的 SQL 执行落库（谁、何时、查了什么、是否脱敏）。
# 只记 SQL 与元数据，**不记结果集**（结果集可能含敏感数据）。
# 用途：① 合规审计 ② 问题追溯 ③ 成本与质量指标（拒绝率/脱敏触发次数）
SQL_AUDIT_ENABLED=true

# 请求级性能/用量数值记录，默认关闭。开启后需重启API。
# 推荐绝对路径，例如 D:/PythonProjects/personal_rag/output/performance_usage.jsonl
# 不记录题目、答案或密钥；压测报告通过 X-Request-ID 关联。
PERFORMANCE_LOG_FILE=

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
